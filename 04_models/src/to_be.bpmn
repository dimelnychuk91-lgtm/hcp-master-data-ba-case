        <bpmndi:BPMNLabel><dc:Bounds x="415.0" y="86" width="130" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Link_di" bpmnElement="T_Link" bioc:fill="#E3EEFA" bioc:stroke="#3B6EA8" color:background-color="#E3EEFA" color:border-color="#3B6EA8"><dc:Bounds x="570" y="105" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Create_di" bpmnElement="T_Create" bioc:fill="#E3EEFA" bioc:stroke="#3B6EA8" color:background-color="#E3EEFA" color:border-color="#3B6EA8"><dc:Bounds x="540" y="215" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Split_di" bpmnElement="P_Split" bioc:fill="#FFF4E0" bioc:stroke="#C98A1B" color:background-color="#FFF4E0" color:border-color="#C98A1B"><dc:Bounds x="675" y="230" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Join_di" bpmnElement="G_Join" isMarkerVisible="true" bioc:fill="#FFF4E0" bioc:stroke="#C98A1B" color:background-color="#FFF4E0" color:border-color="#C98A1B"><dc:Bounds x="735" y="120" width="50" height="50" />
      </bpmndi:BPMNShape>
