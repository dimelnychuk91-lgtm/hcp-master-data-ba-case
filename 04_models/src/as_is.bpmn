<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Process_AsIs" targetNamespace="http://example.com/bpmn/hcp-case">
  <bpmn:collaboration id="Collab_Process_AsIs">
    <bpmn:participant id="Pool_Process_AsIs" name="PharmaCo after the acquisition (AS-IS)" processRef="Process_AsIs" />
    <bpmn:participant id="Pool_Regulator" name="Regulators (CMS Open Payments, national platforms)" />
    <bpmn:participant id="Pool_Doctor" name="Doctors" />
    <bpmn:messageFlow id="M1" name="Disclosure report" sourceRef="T_Upload" targetRef="Pool_Regulator" />
    <bpmn:messageFlow id="M2" name="Published amounts" sourceRef="Pool_Regulator" targetRef="Pool_Doctor" />
    <bpmn:messageFlow id="M3" name="Dispute" sourceRef="Pool_Doctor" targetRef="IE_Dispute" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_AsIs">
      <bpmn:lane id="Lane_Rep" name="Field reps (PharmaCo and BioCo)">
        <bpmn:flowNodeRef>S_Met</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SearchOwn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateRec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Logged</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tr" name="Transparency team">
        <bpmn:flowNodeRef>S_Cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Export</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Certain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Totals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_IntRev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IE_Dispute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Met" name="Doctor met">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_SearchOwn" name="Search own CRM">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Found" name="Doctor found in own CRM?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_CreateRec" name="Create new doctor record">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Join1">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Log" name="Log visit or payment">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_Logged" name="Visit logged">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_Src" name="CRMs, events and spend systems" />
    <bpmn:startEvent id="S_Cycle" name="Annual reporting cycle">
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_S_Cycle" />
    </bpmn:startEvent>
    <bpmn:task id="T_Export" name="Export payments from 3 systems">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:property id="Prop_T_Export" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_T_Export_0"><bpmn:sourceRef>DS_Src</bpmn:sourceRef><bpmn:targetRef>Prop_T_Export</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="T_Match" name="Match doctors by surname and city">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Certain" name="Match certain?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Review" name="Review ~3,000 pairs by hand (no decision log)">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Join2">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Totals" name="Build totals per doctor">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_IntRev" name="Internal review and corrections (~2 weeks)">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="T_Upload" name="Upload report to regulator portals">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="IE_Dispute" name="Dispute received">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_IE_Dispute" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_Correct" name="Correct totals in spreadsheet">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_Done" name="Cycle closed">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S_Met" targetRef="T_SearchOwn" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_SearchOwn" targetRef="G_Found" />
    <bpmn:sequenceFlow id="F3" name="Yes" sourceRef="G_Found" targetRef="G_Join1" />
    <bpmn:sequenceFlow id="F4" name="No" sourceRef="G_Found" targetRef="T_CreateRec" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_CreateRec" targetRef="G_Join1" />
    <bpmn:sequenceFlow id="F6" sourceRef="G_Join1" targetRef="T_Log" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_Log" targetRef="E_Logged" />
    <bpmn:sequenceFlow id="F10" sourceRef="S_Cycle" targetRef="T_Export" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Export" targetRef="T_Match" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_Match" targetRef="G_Certain" />
    <bpmn:sequenceFlow id="F13" name="Yes" sourceRef="G_Certain" targetRef="G_Join2" />
    <bpmn:sequenceFlow id="F14" name="No" sourceRef="G_Certain" targetRef="T_Review" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_Review" targetRef="G_Join2" />
    <bpmn:sequenceFlow id="F16" sourceRef="G_Join2" targetRef="T_Totals" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_Totals" targetRef="T_IntRev" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_IntRev" targetRef="T_Upload" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_Upload" targetRef="IE_Dispute" />
    <bpmn:sequenceFlow id="F20" sourceRef="IE_Dispute" targetRef="T_Correct" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_Correct" targetRef="E_Done" />
    <bpmn:textAnnotation id="Note_Legend"><bpmn:text>Red: pain points found in discovery (P1 to P5)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_AsIs">
    <bpmndi:BPMNPlane id="Plane_Process_AsIs" bpmnElement="Collab_Process_AsIs">
      <bpmndi:BPMNShape id="Pool_Process_AsIs_di" bpmnElement="Pool_Process_AsIs" isHorizontal="true"><dc:Bounds x="160" y="80" width="1620" height="440" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Rep_di" bpmnElement="Lane_Rep" isHorizontal="true"><dc:Bounds x="190" y="80" width="1590" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Tr_di" bpmnElement="Lane_Tr" isHorizontal="true"><dc:Bounds x="190" y="280" width="1590" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_Regulator_di" bpmnElement="Pool_Regulator" isHorizontal="true"><dc:Bounds x="960" y="580" width="400" height="60" /></bpmndi:BPMNShape>
