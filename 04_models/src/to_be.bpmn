        <di:waypoint x="480" y="170" />
        <di:waypoint x="480" y="255" />
        <di:waypoint x="540" y="255" />
        <bpmndi:BPMNLabel><dc:Bounds x="486" y="200" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5" bioc:stroke="#4A5A70" color:border-color="#4A5A70">
        <di:waypoint x="670" y="145" />
        <di:waypoint x="735" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6" bioc:stroke="#4A5A70" color:border-color="#4A5A70">
        <di:waypoint x="640" y="255" />
