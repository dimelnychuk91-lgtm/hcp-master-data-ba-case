      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Check_di" bpmnElement="T_Check" bioc:fill="#E3EEFA" bioc:stroke="#3B6EA8" color:background-color="#E3EEFA" color:border-color="#3B6EA8"><dc:Bounds x="1130" y="745" width="100" height="80" />
      </bpmndi:BPMNShape>
