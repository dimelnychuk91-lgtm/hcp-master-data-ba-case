      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Pub_di" bpmnElement="E_Pub" bioc:fill="#FFFFFF" bioc:stroke="#B5452F" color:background-color="#FFFFFF" color:border-color="#B5452F"><dc:Bounds x="1432" y="402" width="36" height="36" />
